{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "domains": {
      "type": "object",
      "description": "DNS records",
      "additionalProperties": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "domains"
  ],
  "$defs": {
    "record": {
      "oneOf": [
        {
          "description": "Another domain name, which we will create a CNAME to.",
          "format": "hostname",
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "description": "Codeberg Pages",
          "properties": {
            "codeberg": {
              "pattern": "^[\\w-]+/[\\w-]+$",
              "type": "string",
              "description": "A reference to a Codeberg repository, in the form of owner/name."
            }
          },
          "required": [
            "codeberg"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
